{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://petitan.hu/schemas/calibration-template.json",
  "title": "Kalibrálási Eljárás Sablon",
  "description": "JSON schema for calibration procedure template (docjl compatible)",
  "type": "object",
  "required": ["docjll"],
  "properties": {
    "docjll": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "heading",
              "paragraph",
              "table",
              "list_ordered",
              "list_unordered",
              "equation",
              "code_block",
              "quote",
              "horizontal_rule",
              "image"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
