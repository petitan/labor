{
  "chapter": "03",
  "title": "Szakkifejezések és meghatározásuk",
  "intro": {
    "text": "A Minőségirányítási Kézikönyvre és a minőségirányítási rendszerben használt legfontosabb kifejezésekre az MSZ EN ISO/IEC 17025:2018 szabványban megadottakon túlmenően az alábbi szabványok és dokumentumok idevonatkozó szakkifejezései és meghatározásai érvényesek, mindig az aktuális kiadású (évszámú) változat szerint:",
    "referenced_standards": [
      {
        "name_hu": "Megfelelőségértékelés. Szakszótár és általános elvek",
        "id": "MSZ EN ISO/IEC 17000"
      },
      {
        "name_hu": "Minőségirányítási rendszerek. Alapok és szótár",
        "id": "ISO 9000"
      },
      {
        "url": "https://aszek.hu/images/dokok/VIM_3_HU.pdf",
        "name_hu": "Nemzetközi metrológiai értelmező szótár magyar fordítása",
        "id": "VIM3"
      },
      {
        "name_hu": "Mérési bizonytalanság meghatározása kalibrálásnál / B függelék",
        "id": "EA-4/02 M:2022_HUN"
      }
    ]
  },
  "key_definitions": {
    "calibration": "Olyan műveletek összessége, amelyek meghatározott feltételek mellett összefüggést teremtenek a mérőeszköz vagy mérőrendszer által mutatott értékek, illetve a mérési etalonokkal megvalósított megfelelő értékek között.",
    "measurement_uncertainty": "A mérési eredményhez társított paraméter, amely a mérendő mennyiség értékének tulajdonítható értékek szórását jellemzi.",
    "traceability": "A mérési eredmény olyan tulajdonsága, amelynek révén az eredmény megszakítás nélküli mérési kalibrálási láncon keresztül kapcsolható valamely etalonhoz.",
    "accreditation": "Harmadik fél általi tanúsítás arról, hogy egy megfelelőségértékelő szerv megfelel az adott szabványban rögzített követelményeknek."
  },
